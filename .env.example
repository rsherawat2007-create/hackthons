# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# If you run the bundled embedded-postgres helper (node scripts/ensure-postgres.mjs)
# this value is set automatically. For external Postgres, update accordingly.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatorhub?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Change to a long random string in production.
JWT_SECRET="change-me"

# Token lifetime (vercel/ms format: "7d", "24h", "3600s")
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# URL the Express CORS policy whitelists. Must match your Vite dev server origin.
CLIENT_URL="http://localhost:5173"

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Leave blank to use the built-in deterministic demo fallback in the Brief Builder.
# Any OpenAI-compatible key works (OpenAI, Together, Groq, Azure OpenAI, etc.)
OPENAI_API_KEY=""

# Base URL for the chat-completions endpoint.
# Change to point at Together, Groq, Azure, or a local Ollama instance.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Model to use for brief generation.
OPENAI_MODEL="gpt-4o-mini"

# ── SMS Provider (optional) ──────────────────────────────────────────────────
# Default is "development" (safe console logger, no external SMS charges or leaks).
# Set to "twilio" to enable real Twilio delivery.
SMS_PROVIDER="development"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Disposable & Temporary Phone Detection (optional) ────────────────────────
# Default is "development" (clean validation with built-in development test hooks).
# Supported providers:
#   "development" : Demo mode (clean check; test disposable triggers: ends with 9999 or contains 000000)
#   "twilio"      : Twilio Lookup v2 line-type intelligence (re-uses TWILIO_ACCOUNT_SID & AUTH_TOKEN)
#   "generic"     : Generic carrier intelligence endpoint (AbstractAPI, Numverify, IPQS, etc.)
PHONE_DETECTOR_PROVIDER="development"

# Generic disposable detector endpoint (required only if PHONE_DETECTOR_PROVIDER="generic")
# PHONE_VALIDATION_URL="https://phonevalidation.abstractapi.com/v1/"
# PHONE_VALIDATION_API_KEY=""


